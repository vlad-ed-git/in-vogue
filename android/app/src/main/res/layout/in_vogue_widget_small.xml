<?xml version="1.0" encoding="utf-8"?>
<!-- Small: the slab is the whole widget; weather only, since a figure can't be read this small. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_rouge"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="13dp">

    <ImageView
        android:id="@+id/widget_glyph"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_kicker"
        style="@style/WidgetKicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@id/widget_glyph" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_numeral"
            style="@style/WidgetNumeral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-5dp"
            android:textSize="104dp" />

        <TextView
            android:id="@+id/widget_condition"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>
</RelativeLayout>
