<?xml version="1.0" encoding="utf-8"?>
<!-- Medium: the Rouge slab, 206 of 338, beside the portrait running the full height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_rouge"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="206"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <ImageView
            android:id="@+id/widget_glyph"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_kicker"
            style="@style/WidgetKicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/widget_glyph" />

        <TextView
            android:id="@+id/widget_date"
            style="@style/WidgetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_kicker"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/widget_glyph" />

        <!-- The numeral, a picture, shrinks to the room below the date. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_date"
            android:layout_alignParentBottom="true"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_numeral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_condition"
                style="@style/WidgetCondition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="2dp"
                android:textSize="13dp" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="132">

        <!-- Wider than the photo: contained on studio grey, never cut. -->
        <ImageView
            android:id="@+id/widget_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_waiting"
            style="@style/WidgetWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
