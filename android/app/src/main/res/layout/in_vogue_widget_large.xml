<?xml version="1.0" encoding="utf-8"?>
<!-- Large: the Rouge slab, 154 of 338, beside the portrait running the full height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_rouge"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="154"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/widget_kicker"
            style="@style/WidgetKicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true" />

        <TextView
            android:id="@+id/widget_date"
            style="@style/WidgetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_kicker"
            android:layout_marginTop="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_date"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- The numeral, a picture, shrinks to the room the words below leave it. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_numeral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_glyph"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="18dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_condition"
                style="@style/WidgetCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/widget_feels"
                style="@style/WidgetDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="184">

        <!-- Narrower than the photo: only its sides are trimmed. -->
        <ImageView
            android:id="@+id/widget_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_waiting"
            style="@style/WidgetWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
