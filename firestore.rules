rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each person reads and writes only their own account and what is
    // under it. The plan is set once, at creation, to the plan every new
    // account gets (AccountModel.demoPlan); only the console changes it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && (!('plan' in request.resource.data)
          || request.resource.data.plan == 'pro');
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);

      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Error reports: a signed-in person files their own, with fixed fields
    // and sizes. Nobody reads, changes or deletes one from the app.
    match /errors/{report} {
      allow create: if request.auth != null && isReport(request.resource.data);
    }

    function isReport(data) {
      let fields = ['account', 'at', 'where', 'error', 'stack', 'flavor',
        'platform', 'version', 'build', 'install'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.account == request.auth.uid
        && data.at is timestamp
        && data.where is string && data.where.size() <= 200
        && data.error is string && data.error.size() <= 300
        && data.stack is string && data.stack.size() <= 4000
        && data.flavor in ['development', 'production']
        && data.platform in ['android', 'ios']
        && data.version is string && data.version.size() <= 40
        && data.build in ['debug', 'profile', 'release']
        && data.install is string && data.install.size() <= 64;
    }
  }
}
