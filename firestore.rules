rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each person reads and writes only their own account and what is
    // under it. The plan is set once, at creation, to the plan every new
    // account gets (AccountModel.demoPlan); only the console changes it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && (!('plan' in request.resource.data)
          || request.resource.data.plan == 'pro');
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);

      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
