rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each person reads and writes only their own account and what is
    // under it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The development try-on budget: signed-in people reserve and give
    // back units, never past the limit of 30, and never change the limit.
    match /usage/youcam {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validUsage(request.resource.data)
        && request.resource.data.unitLimit == 30;
      allow update: if request.auth != null
        && validUsage(request.resource.data)
        && request.resource.data.unitLimit == resource.data.unitLimit;
    }

    function validUsage(usage) {
      return usage.keys().hasOnly(['unitsSpent', 'unitLimit', 'updatedAt'])
        && usage.unitsSpent is int
        && usage.unitLimit is int
        && usage.unitsSpent >= 0
        && usage.unitsSpent <= usage.unitLimit;
    }
  }
}
